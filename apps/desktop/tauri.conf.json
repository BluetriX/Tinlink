{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinlink",
  "version": "0.1.0",
  "identifier": "org.tinlink.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tinlink",
        "width": 440,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
