{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinlink",
  "version": "0.1.0",
  "identifier": "org.tinlink.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tinlink",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
