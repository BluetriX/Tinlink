# Public domain of this Tinlink server (user ids become name@TINLINK_DOMAIN).
TINLINK_DOMAIN=localhost
# URL clients use to reach LiveKit. Caddy forwards /rtc on TINLINK_DOMAIN to
# LiveKit, so on a public server this is wss://<TINLINK_DOMAIN>.
# Local development: ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IP that LiveKit announces for media (UDP 50000-50100, TCP 7881).
# Leave empty to auto-detect. Docker in WSL2 (NAT networking) must announce
# the WSL address so Windows clients can reach it: `hostname -I | cut -d' ' -f1`
# (it changes when WSL restarts).
LIVEKIT_NODE_IP=

# Generate with: openssl rand -hex 16 / openssl rand -base64 32
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters
POSTGRES_PASSWORD=change-me

# Development only: issue voice tokens without login.
TINLINK_DEV_INSECURE_TOKENS=false

# Allow anyone to register (the first account can always be created).
TINLINK_OPEN_REGISTRATION=true

# Maximum size of a single uploaded file.
TINLINK_MAX_UPLOAD_MB=25
