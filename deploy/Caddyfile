# TLS certificates are obtained automatically. For "localhost" Caddy uses
# its own local CA.

{$TINLINK_DOMAIN} {
	encode zstd gzip
	reverse_proxy /api/* server:8080
	reverse_proxy /health server:8080
}

# LiveKit signaling (WebSocket). Media itself uses UDP 50000-50100 directly.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}
